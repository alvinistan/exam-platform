# Copy to .env and replace every value. .env is git-ignored; never commit real secrets.
# Generate strong values with:  openssl rand -base64 24   (or PowerShell: [Convert]::ToBase64String((1..24|%{Get-Random -Max 256})))

# PostgreSQL superuser (local Docker only)
POSTGRES_PASSWORD=change-me-postgres

# One login per service database (ADR-003)
IDENTITY_DB_PASSWORD=change-me-identity
CATALOG_DB_PASSWORD=change-me-catalog
ASSESSMENT_DB_PASSWORD=change-me-assessment
LEARNING_DB_PASSWORD=change-me-learning
BILLING_DB_PASSWORD=change-me-billing

# Google sign-in (Phase 5). Create a "Web application" OAuth client in Google Cloud Console with the redirect URI
# http://localhost:8088/api/auth/google/callback (and http://localhost:5173/api/auth/google/callback for npm run dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Google email that becomes the first administrator on its first sign-in. Used once, then ignored.
ADMIN_BOOTSTRAP_EMAIL=
# Where people open the web app; sign-in returns here.
PUBLIC_BASE_URL=http://localhost:8088
# Access-token signing keys (JWK set JSON). Leave empty locally: a temporary key is generated at startup.
# Staging and production must set it; see README "Signing keys".
IDENTITY_JWT_SIGNING_KEYS=

# Signs short-lived question image links (base64, at least 32 bytes: openssl rand -base64 32).
# Leave empty locally: a temporary key is generated and image links stop working after a restart.
CATALOG_MEDIA_SIGNING_KEY=

# Lets subscription-service read the catalogue's events (Phase 8). Any long random value; identity-service and
# subscription-service both read it from here.
SUBSCRIPTION_SERVICE_CLIENT_SECRET=change-me-subscription-client

# Added in later phases: payment provider keys.
