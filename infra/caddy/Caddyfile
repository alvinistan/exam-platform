# Serves the React app and proxies the API. Locally SITE_ADDRESS is ":8080" (plain HTTP inside Docker);
# in staging/production it is the domain name, and Caddy obtains and renews the TLS certificate (ADR-013).
{
	admin off
}

{$SITE_ADDRESS}

encode zstd gzip

header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	Cross-Origin-Opener-Policy "same-origin"
	Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com"
	-Server
}

respond /healthz 200

@api path /api/* /.well-known/*
handle @api {
	reverse_proxy {$GATEWAY_UPSTREAM}
}

handle {
	root * /srv
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
